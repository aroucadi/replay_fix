{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replayfix.dev/schemas/v0.9/sweep_receipt.schema.json",
  "title": "SweepReceipt",
  "description": "Benchmark sweep summary record covering RF-01 through RF-05 repair runs with Merkle root and Ed25519 attestation.",
  "type": "object",
  "required": [
    "schema_version",
    "total_evaluated",
    "total_verified",
    "pass_rate",
    "elapsed_wall_clock_ms",
    "results",
    "merkle_root",
    "attestation",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.9"
    },
    "total_evaluated": {
      "type": "integer",
      "minimum": 0
    },
    "total_verified": {
      "type": "integer",
      "minimum": 0
    },
    "pass_rate": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "elapsed_wall_clock_ms": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bug_id",
          "verified",
          "merkle_root",
          "duration_ms"
        ],
        "properties": {
          "bug_id": { "type": "string" },
          "verified": { "type": "boolean" },
          "merkle_root": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "error": { "type": "string" }
        }
      }
    },
    "merkle_root": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "attestation": {
      "$ref": "attestation.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
