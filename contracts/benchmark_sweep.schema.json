{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BenchmarkSweepSummary",
  "type": "object",
  "required": [
    "schema_version",
    "suite_name",
    "total_bugs",
    "success_count",
    "failure_count",
    "gate1_red_rate",
    "gate2_green_rate",
    "mean_latency_ms",
    "p95_latency_ms",
    "total_tokens",
    "wall_clock_duration_secs",
    "batch_merkle_root",
    "ed25519_signature",
    "public_key_hex",
    "results"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "suite_name": { "type": "string" },
    "total_bugs": { "type": "integer", "minimum": 0 },
    "success_count": { "type": "integer", "minimum": 0 },
    "failure_count": { "type": "integer", "minimum": 0 },
    "gate1_red_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "gate2_green_rate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "mean_latency_ms": { "type": "number", "minimum": 0.0 },
    "p95_latency_ms": { "type": "number", "minimum": 0.0 },
    "total_tokens": {
      "type": "object",
      "required": ["input_tokens", "output_tokens", "cached_tokens"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "cached_tokens": { "type": "integer", "minimum": 0 }
      }
    },
    "wall_clock_duration_secs": { "type": "number", "minimum": 0.0 },
    "batch_merkle_root": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "ed25519_signature": { "type": "string" },
    "public_key_hex": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bug_id",
          "status",
          "gate1_reproduced",
          "gate2_verified",
          "latency_ms",
          "merkle_leaf_hash"
        ],
        "properties": {
          "bug_id": { "type": "string" },
          "status": { "type": "string", "enum": ["SUCCESS", "FAILED", "SKIPPED"] },
          "gate1_reproduced": { "type": "boolean" },
          "gate2_verified": { "type": "boolean" },
          "latency_ms": { "type": "number", "minimum": 0.0 },
          "tokens_used": { "type": "integer", "minimum": 0 },
          "merkle_leaf_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "error_message": { "type": ["string", "null"] }
        }
      }
    }
  }
}
