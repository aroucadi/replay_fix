{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IssueIngestion",
  "description": "Normalized GitHub issue ingestion result schema for ReplayFix",
  "type": "object",
  "required": [
    "issue_ref",
    "title",
    "raw_body",
    "extracted_steps",
    "untrusted_context_block",
    "retrieved_at"
  ],
  "properties": {
    "issue_ref": {
      "type": "object",
      "required": ["owner", "repo", "issue_number"],
      "properties": {
        "owner": { "type": "string" },
        "repo": { "type": "string" },
        "issue_number": { "type": "integer", "minimum": 1 }
      }
    },
    "title": { "type": "string" },
    "raw_body": { "type": "string" },
    "extracted_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "untrusted_context_block": { "type": "string" },
    "retrieved_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
